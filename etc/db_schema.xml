<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="panth_index_now_queue" resource="default" engine="innodb" comment="IndexNow URL submission queue">
        <column xsi:type="int" name="queue_id" unsigned="true" nullable="false" identity="true" comment="Queue ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="varchar" name="url_hash" length="40" nullable="false" comment="SHA1 of the URL"/>
        <column xsi:type="text" name="url" nullable="false" comment="URL"/>
        <column xsi:type="varchar" name="action" length="16" nullable="false" default="update" comment="update or delete"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Failed submission attempts"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="queue_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PANTH_INDEX_NOW_QUEUE_STORE_ID_URL_HASH">
            <column name="store_id"/>
            <column name="url_hash"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PANTH_INDEX_NOW_QUEUE_STORE_ID_STORE_STORE_ID"
                    table="panth_index_now_queue" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="PANTH_INDEX_NOW_QUEUE_UPDATED_AT" indexType="btree">
            <column name="updated_at"/>
        </index>
    </table>
</schema>
