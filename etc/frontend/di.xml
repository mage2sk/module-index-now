<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="panth_indexnow" xsi:type="array">
                    <item name="class" xsi:type="string">Panth\IndexNow\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">25</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="panth_indexnow_key_file_headers"
                type="Panth\IndexNow\Plugin\Response\KeyFileHeadersPlugin"
                sortOrder="10000"/>
    </type>
</config>
